# Grok true-form query + finished-piece renders
XAI_API_KEY=

# Stage 3 — custom domain host (no scheme). Default in code is yard.wiki.
# VITE_PUBLIC_HOSTNAME=yard.wiki

# Stage 3 — Plausible analytics (only loads when set)
# VITE_PUBLIC_PLAUSIBLE_DOMAIN=yard.wiki

# Optional — AI prompt reader (I49). Ships OFF: leave unset. "on" (exactly) turns it on, server-side per request and in the
# browser at build time (redeploy after changing). It uses the XAI_API_KEY above and the Upstash store; the $1/day cap is fixed.
# YARD_AI_READER=
# Calls per visitor per day for the reader (default 20).
# YARD_DAILY_READER_CAP=
# Can only lower the $1/day reader cap, never raise it.
# YARD_AI_READER_DAILY_USD=

# Optional later — Amazon Associates tag for monetized shop links (ask before setting)
# VITE_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Optional — auth / production DB (preview uses PGLite without these)
# DATABASE_URL=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
