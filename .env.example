# Grok true-form query + finished-piece renders
XAI_API_KEY=

# Stage 3 — custom domain host (no scheme). Default in code is yard.wiki.
# VITE_PUBLIC_HOSTNAME=yard.wiki

# Stage 3 — Plausible analytics (only loads when set)
# VITE_PUBLIC_PLAUSIBLE_DOMAIN=yard.wiki

# Optional later — Amazon Associates tag for monetized shop links (ask before setting)
# VITE_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Optional — auth / production DB (preview uses PGLite without these)
# DATABASE_URL=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
